# =============================================================================
# BigQuery 外部キー不整合検知バッチ - ローカル実行用 環境変数サンプル
#
# このファイルを `.env` にコピーして値を埋めてください（`.env` は Git 管理外）。
#   cp .env.example .env
#
# ローカルでは ADC（Application Default Credentials）で BigQuery に接続します。
#   gcloud auth application-default login
# もしくはサービスアカウントキーを使う場合は GOOGLE_APPLICATION_CREDENTIALS を指定。
# =============================================================================

# GCP プロジェクト ID（未設定時は usenpay-connect-dev）
GCP_PROJECT_ID=usenpay-connect-dev

# BigQuery データセット ID（未設定時は connect_db）
BQ_DATASET_ID=connect_db

# BigQuery のロケーション（未設定時は asia-northeast1）
BQ_LOCATION=asia-northeast1

# Slack Incoming Webhook URL（不整合検知時のみ送信。未設定時は Slack 通知をスキップ）
SLACK_WEBHOOK_URL=

# Looker Studio ダッシュボードの共有 URL（Slack 通知のリンクに使用）
LOOKER_STUDIO_URL=

# 実行環境ラベル（Slack 表示用。development / production）
ENV=development

# true の場合、日付フィルターを無効化して全レコードをスキャン（初回投入/リカバリ用）
ALL_RECORDS=false

# （任意）ローカルでサービスアカウントキーを使う場合のみ
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
